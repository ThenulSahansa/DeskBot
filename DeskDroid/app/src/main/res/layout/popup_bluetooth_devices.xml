<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_neon_popup"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/popupTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/available_bt_devices"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/scanProgressBar"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#00E5FF"
        android:layout_marginBottom="4dp" />

    <ListView
        android:id="@+id/deviceListView"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:divider="#1A00E5FF"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/emptyDevicesText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_devices_found"
        android:textColor="#80D8FF"
        android:textSize="12sp"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScanDevices"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="6dp"
        android:text="@string/scan_for_devices"
        android:textColor="#00E5FF"
        android:textSize="12sp"
        android:textStyle="bold"
        app:backgroundTint="#121A24"
        app:strokeColor="#00E5FF"
        app:strokeWidth="1dp"
        app:cornerRadius="8dp" />
</LinearLayout>