<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <!-- Connect Button: Main liquid neon button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:text="@string/connect"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:cornerRadius="80dp"
        app:backgroundTint="@color/neon_blue"
        app:strokeColor="@color/neon_blue_light"
        app:strokeWidth="3dp"
        app:elevation="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/button2"
        app:layout_constraintVertical_bias="0.38" />

    <!-- Button 2: Check for updates (Neon outline button) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button2"
        android:layout_width="345dp"
        android:layout_height="52dp"
        android:text="@string/check_for_updates"
        android:textColor="@color/neon_blue"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:backgroundTint="@color/dark_surface"
        app:strokeColor="@color/neon_blue"
        app:strokeWidth="2dp"
        app:elevation="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="48dp" />

    <!-- Button 3: Target reference for top-right corner positioning -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button3"
        android:layout_width="115dp"
        android:layout_height="40dp"
        android:text="@string/disconnect"
        android:visibility="invisible"
        tools:visibility="visible"
        android:textSize="11sp"
        android:textStyle="bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        tools:layout_editor_absoluteX="319dp"
        tools:layout_editor_absoluteY="2dp" />

</androidx.constraintlayout.widget.ConstraintLayout>