<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.DeskBot" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- iOS Color System -->
        <item name="colorPrimary">@color/ios_blue</item>
        <item name="colorOnPrimary">@color/ios_label_primary</item>
        <item name="colorSecondary">@color/ios_cyan</item>
        <item name="colorSurface">@color/ios_background</item>
        <item name="colorOnSurface">@color/ios_label_primary</item>

        <!-- System Bars for true Edge-To-Edge Experience -->
        <item name="android:windowBackground">@color/ios_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Ripple effects -->
        <item name="colorControlHighlight">#26FFFFFF</item>
    </style>
</resources>