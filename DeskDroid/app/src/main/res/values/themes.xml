<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Flat Catppuccin Base Theme -->
    <style name="Base.Theme.DeskBot" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Catppuccin Color System -->
        <item name="colorPrimary">@color/catppuccin_mauve</item>
        <item name="colorOnPrimary">@color/catppuccin_crust</item>
        <item name="colorSecondary">@color/catppuccin_blue</item>
        <item name="colorSurface">@color/catppuccin_surface0</item>
        <item name="colorOnSurface">@color/catppuccin_text</item>

        <!-- System Bars -->
        <item name="android:windowBackground">@color/catppuccin_base</item>
        <item name="android:statusBarColor">@color/catppuccin_base</item>
        <item name="android:navigationBarColor">@color/catppuccin_base</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Ripple effects -->
        <item name="colorControlHighlight">#1FCBA6F7</item>
    </style>

    <style name="Theme.DeskBot" parent="Base.Theme.DeskBot" />

    <!-- Flat Catppuccin BottomSheet Dialog Style -->
    <style name="FlatBottomSheetDialogTheme" parent="Theme.Design.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/FlatBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/catppuccin_mantle</item>
    </style>

    <style name="FlatBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>